# Django / coffee shop backend — copy to `.env` for local overrides.
# Never commit real production secrets.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set false/omit in local HTTP; set true only behind HTTPS (Render + Cloudflare)
# SECURE_SSL=true

POSTGRES_DB=spylt_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# REQUIRED for multi-instance / ~50k concurrent (cache + WebSocket fan-out)
# REDIS_URL=redis://127.0.0.1:6379/0
# DATABASE_URL=postgres://user:pass@host:5432/spylt_db

DB_CONN_MAX_AGE=60
WS_MAX_CONNECTIONS_PER_PROCESS=2500
WS_MAX_CONNECTIONS_GLOBAL=60000
MENU_CACHE_SECONDS=30
CHANNEL_CAPACITY=5000

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your@gmail.com

RATE_LIMIT_IP_REQUESTS=120
RATE_LIMIT_IP_WINDOW=60
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW=900

# CORS_ALLOWED_ORIGINS=https://your-frontend.example
# CSRF_TRUSTED_ORIGINS=https://your-frontend.example
